{
  "agent": {
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/apache2/drupal-access.log",
            "log_group_name": "{{ log_prefix }}/apache-access",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/apache2/drupal-error.log",
            "log_group_name": "{{ log_prefix }}/apache-error",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "{{ log_prefix }}/syslog",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/user-data.log",
            "log_group_name": "{{ log_prefix }}/bootstrap",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  }
}
